# Masud Telecom Environment Variables Configuration

# Client-Side Push Configuration:
# Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates -> Key pair (Public Key)
VITE_FIREBASE_VAPID_KEY=

# Server-Side Push Configuration:
# Firebase Console -> Project Settings -> Cloud Messaging -> Cloud Messaging API (Server Key)
FCM_SERVER_KEY=

# Firebase Admin Service Account Key JSON (Optional for FCM HTTP v1 API)
FIREBASE_SERVICE_ACCOUNT_KEY=
