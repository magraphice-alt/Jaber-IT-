{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, roles, balances and total stats",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "mobile": { "type": "string" },
        "role": { "type": "string" },
        "balance": { "type": "number" },
        "commissionRate": { "type": "number" },
        "avatarUrl": { "type": "string" },
        "totalSend": { "type": "number" },
        "totalCommission": { "type": "number" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "balance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction requests (send, deposit, charge)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "type": { "type": "string" },
        "recipientMobile": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "comment": { "type": "string" },
        "attachmentUrl": { "type": "string" },
        "attachmentName": { "type": "string" },
        "status": { "type": "string" },
        "commissionEarned": { "type": "number" },
        "createdAt": { "type": "string" },
        "approvedAt": { "type": "string" },
        "adminPin": { "type": "string" },
        "rejectionReason": { "type": "string" },
        "isResent": { "type": "boolean" },
        "resentTxnId": { "type": "string" },
        "resentAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "method", "status"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "System or user notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string" },
        "txnId": { "type": "string" },
        "url": { "type": "string" },
        "referenceId": { "type": "string" },
        "eventId": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message"]
    },
    "UserDevice": {
      "title": "UserDevice",
      "description": "Registered device tokens for mobile and desktop push notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "token": { "type": "string" },
        "deviceType": { "type": "string" },
        "browser": { "type": "string" },
        "platform": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastUsedAt": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "userId", "token", "deviceType"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/transactions/{txnId}": {
      "schema": "Transaction",
      "description": "Financial transactions"
    },
    "/notifications/{notifId}": {
      "schema": "NotificationItem",
      "description": "In-app and push notifications"
    },
    "/userDevices/{deviceId}": {
      "schema": "UserDevice",
      "description": "Device tokens for Android mobile and desktop PWA push notifications"
    }
  }
}
